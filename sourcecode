; ============================================================================
; Virtual Piano AUTO - Legacy compatibility shim
; ----------------------------------------------------------------------------
; Launchers older than 2.0 download THIS file from raw.githubusercontent.com/
; the-sleepless/virtual-piano-auto/main/sourcecode (see the old Piano_Launcher
; v0.0.1). It simply fetches the real launcher from the latest GitHub Release
; and runs it - the application itself now lives in src/VirtualPianoAuto.ahk
; and is distributed as release assets.
;
; New users should download launcher/Piano_Launcher.ahk from the latest
; release instead.
; ============================================================================
#Requires AutoHotkey v2.0
#SingleInstance Force

LAUNCHER_URL := "https://github.com/the-sleepless/virtual-piano-auto/releases/latest/download/Piano_Launcher.ahk"
LEGACY_CACHE := A_Temp "\virtual_piano_temp.ahk"
BOOTSTRAP := A_Temp "\VirtualPianoAuto.launcher.ahk"

if DownloadFile(LAUNCHER_URL, BOOTSTRAP) {
    Run(A_AhkPath ' "' BOOTSTRAP '"')
    ExitApp(0)
}

; Offline fallbacks: run whatever is available.
if FileExist(BOOTSTRAP) {
    Run(A_AhkPath ' "' BOOTSTRAP '"')
    ExitApp(0)
}
if FileExist(LEGACY_CACHE) {
    Run(A_AhkPath ' "' LEGACY_CACHE '"')
    ExitApp(0)
}

MsgBox("Could not download Virtual Piano AUTO and no local copy exists.",
    "Virtual Piano AUTO", "Iconx")
ExitApp(1)

DownloadFile(url, dest) {
    try {
        http := ComObjCreate("WinHttp.WinHttpRequest.5.1")
        http.Open("GET", url, false)
        http.SetTimeouts(3000, 3000, 3000, 15000)
        http.SetRequestHeader("User-Agent", "VirtualPianoAuto-LegacyShim")
        http.Send()
        if (http.Status != 200)
            return false
        stream := ComObjCreate("ADODB.Stream")
        stream.Type := 1                ; adTypeBinary
        stream.Open()
        stream.Write(http.ResponseBody)
        stream.SaveToFile(dest, 2)      ; adSaveCreateOverWrite
        stream.Close()
        return true
    }
    return false
}
